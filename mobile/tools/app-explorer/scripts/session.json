[
  { "launch": true, "name": "open app" },
  { "think": 2000, "scroll": "down", "name": "scroll rates 1" },
  { "think": 800, "scroll": "down", "name": "scroll rates 2" },
  { "think": 800, "scroll": "up", "name": "scroll rates back" },
  { "think": 1500, "tap": { "contains": ", Comparison rate" }, "gone": { "contains": "Temporary filters" }, "name": "open product" },
  { "think": 2000, "scroll": "down", "name": "scroll product" },
  { "think": 800, "tap": "Show Fees", "timeout": 800, "optional": true, "name": "expand visible fees" },
  { "think": 1200, "tap": "Show Product facts", "scroll": true, "optional": true, "name": "expand product facts" },
  { "think": 1200, "scroll": "down", "name": "scroll product fees" },
  { "think": 1200, "scroll": "down", "name": "scroll product eligibility" },
  { "think": 1200, "tap": "Show Eligibility", "scroll": true, "optional": true, "name": "expand eligibility" },
  { "think": 1200, "tap": "Show Constraints", "scroll": true, "optional": true, "name": "expand constraints" },
  { "think": 1200, "scroll": "down", "name": "scroll product sources" },
  { "think": 1000, "back": true, "then": { "contains": "Temporary filters" }, "name": "back to rates" },
  { "think": 1500, "tap": "Lenders", "name": "open lenders" },
  { "think": 1500, "scroll": "down", "name": "scroll lenders" },
  { "think": 1000, "back": true, "name": "back from lenders" },
  { "think": 1500, "tap": "Savings", "then": [{"label": "Savings", "selected": true}, {"id": "compact-product-name"}], "name": "switch to savings" },
  { "think": 1500, "tap": "Home loans", "then": [{"label": "Home loans", "selected": true}, {"id": "compact-product-name"}], "name": "switch to home loans" },
  { "think": 1500, "tap": { "contains": "Temporary filters" }, "name": "open filters" },
  { "think": 1500, "back": true, "then": { "contains": "Temporary filters" }, "gone": { "label": "Close Temporary filters" }, "name": "close filters" },
  { "think": 1500, "tap": "Market", "then": { "text": "Cash rate" }, "name": "open market" },
  { "think": 2000, "tap": "RBA", "then": { "contains": "Last confirmed cash rate" }, "name": "open rba" },
  { "think": 2500, "scroll": "down", "name": "scroll rba" },
  { "think": 1000, "back": true, "then": { "text": "Cash rate" }, "name": "back from rba" },
  { "think": 1500, "scroll": "down", "name": "scroll market" },
  { "think": 1500, "tap": "Saved", "name": "open saved" },
  { "think": 1500, "tap": "Rates", "then": { "contains": "Temporary filters" }, "name": "return to rates" }
]
