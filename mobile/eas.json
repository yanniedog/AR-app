{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "24.16.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AR_APP_DISTRIBUTION_CHANNEL": "sideload"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.16.0",
      "env": {
        "NPM_CONFIG_OMIT": "optional",
        "AR_APP_DISTRIBUTION_CHANNEL": "sideload"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "node": "24.16.0",
      "env": {
        "NPM_CONFIG_OMIT": "optional",
        "AR_APP_DISTRIBUTION_CHANNEL": "play"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
